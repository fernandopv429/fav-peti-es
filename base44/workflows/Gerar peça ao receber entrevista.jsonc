{
  "name": "Gerar pe\u00e7a ao receber entrevista",
  "description": "Ao chegar um WebhookEvento do tipo entrevista.salva, gera a pe\u00e7a automaticamente com o modelo indicado.",
  "trigger": {
    "condition": "${ (.trigger.data.evento_tipo == \"entrevista.salva\") }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "WebhookEvento"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "gerar_pe_a_ao_receber_entrevista",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "gerarPecaWebhook",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "gerarPecaWebhook"
  }
}