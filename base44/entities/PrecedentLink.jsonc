{
  "name": "PrecedentLink",
  "type": "object",
  "description": "Links oficiais de veracidade para cada precedente",
  "properties": {
    "precedent_id": {
      "type": "string",
      "description": "ID do precedente"
    },
    "reference": {
      "type": "string",
      "description": "Número da súmula/OJ"
    },
    "source_url": {
      "type": "string",
      "description": "Link oficial do TST para consulta"
    },
    "secondary_url": {
      "type": "string",
      "description": "Link alternativo (JusLaboris, planalto, etc)"
    },
    "verified_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data de verificação do link"
    },
    "notes": {
      "type": "string",
      "description": "Observações sobre o status da súmula"
    }
  },
  "required": [
    "precedent_id",
    "source_url"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.acesso_liberado": true
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.acesso_liberado": true
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.acesso_liberado": true
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.acesso_liberado": true
          }
        }
      ]
    }
  }
}