{
  "name": "Backup",
  "type": "object",
  "description": "Snapshot dos dados do app para backup e restauração",
  "properties": {
    "tipo": {
      "type": "string",
      "enum": [
        "manual",
        "automatico",
        "pre_restauracao"
      ],
      "default": "manual",
      "description": "Tipo de backup"
    },
    "total_registros": {
      "type": "number",
      "description": "Total de registros incluídos no snapshot"
    },
    "tamanho_bytes": {
      "type": "number",
      "description": "Tamanho estimado do JSON em bytes"
    },
    "file_url": {
      "type": "string",
      "description": "URL do arquivo .json salvo via UploadFile (usado quando conteúdo é grande)"
    },
    "conteudo_json": {
      "type": "string",
      "description": "Conteúdo serializado JSON do snapshot (usado quando pequeno o suficiente)"
    },
    "entidades_incluidas": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Lista de entidades incluídas no snapshot"
    },
    "observacao": {
      "type": "string",
      "description": "Observação opcional"
    }
  },
  "required": [
    "tipo"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.acesso_liberado": true
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.acesso_liberado": true
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.acesso_liberado": true
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.acesso_liberado": true
          }
        }
      ]
    }
  }
}