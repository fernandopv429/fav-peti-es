{
  "name": "BackupConfig",
  "type": "object",
  "description": "Configuração do agendamento de backup automático",
  "properties": {
    "ativo": {
      "type": "boolean",
      "default": false,
      "description": "Se o backup automático está ativo"
    },
    "frequencia": {
      "type": "string",
      "enum": [
        "diario",
        "semanal"
      ],
      "default": "diario",
      "description": "Frequência do backup automático"
    },
    "dia_semana": {
      "type": "number",
      "description": "Dia da semana para backup semanal (0=Dom, 1=Seg... 6=Sáb)"
    },
    "hora": {
      "type": "string",
      "default": "02:00",
      "description": "Hora do dia para o backup (HH:MM)"
    }
  },
  "required": [],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.acesso_liberado": true
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.acesso_liberado": true
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.acesso_liberado": true
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.acesso_liberado": true
          }
        }
      ]
    }
  }
}