{
  "name": "ErrorLog",
  "type": "object",
  "description": "Log de erros do sistema para diagnóstico",
  "properties": {
    "context": {
      "type": "string",
      "description": "Onde ocorreu o erro"
    },
    "error_type": {
      "type": "string",
      "enum": [
        "geracao",
        "template",
        "schema",
        "api",
        "outro"
      ]
    },
    "message": {
      "type": "string",
      "description": "Mensagem de erro"
    },
    "petition_id": {
      "type": "string",
      "description": "ID da petição relacionada"
    },
    "template_id": {
      "type": "string",
      "description": "ID do template relacionado"
    },
    "resolved": {
      "type": "boolean",
      "default": false
    },
    "resolution": {
      "type": "string",
      "description": "Como foi resolvido"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "context",
    "error_type",
    "message"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.acesso_liberado": true
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.acesso_liberado": true
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.acesso_liberado": true
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.acesso_liberado": true
          }
        }
      ]
    }
  }
}