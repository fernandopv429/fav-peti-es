{
  "type": "object",
  "properties": {
    "numero": {
      "type": "string",
      "description": "Numero do agente (01-57)"
    },
    "name": {
      "type": "string",
      "description": "Nome tecnico do agente"
    },
    "titulo": {
      "type": "string",
      "description": "Titulo amigavel para exibicao"
    },
    "area": {
      "type": "string",
      "description": "Area do Direito",
      "enum": [
        "Gestão & Prazos",
        "Atendimento & Clientes",
        "Pesquisa Jurídica",
        "Cível",
        "Recursos",
        "Trabalhista",
        "Família & Sucessões",
        "Criminal",
        "Tributário",
        "Empresarial & Contratos",
        "Imobiliário & Locação",
        "Previdenciário",
        "Execução & Cálculo"
      ]
    },
    "icone": {
      "type": "string",
      "description": "Emoji da area"
    },
    "descricao": {
      "type": "string",
      "description": "Descricao / gatilho do agente"
    },
    "tools": {
      "type": "string",
      "description": "Ferramentas que o agente usa"
    },
    "modelo_ia": {
      "type": "string",
      "description": "Modelo de IA",
      "default": "sonnet"
    },
    "prompt_sistema": {
      "type": "string",
      "description": "Corpo do agente: conhecimento e metodo (system prompt)"
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "description": "Se aparece no catalogo"
    }
  },
  "required": [
    "numero",
    "name",
    "area",
    "descricao",
    "prompt_sistema"
  ],
  "name": "Especialista",
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.acesso_liberado": true
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.acesso_liberado": true
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.acesso_liberado": true
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.acesso_liberado": true
          }
        }
      ]
    }
  }
}