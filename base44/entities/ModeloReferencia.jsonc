{
  "name": "ModeloReferencia",
  "type": "object",
  "properties": {
    "titulo": {
      "type": "string",
      "title": "Título"
    },
    "partes": {
      "type": "string",
      "title": "Partes (Reclamante × Reclamada)"
    },
    "funcao": {
      "type": "string",
      "title": "Função",
      "description": "Ex.: Controlador de acesso, Porteiro"
    },
    "sindicato": {
      "type": "string",
      "title": "Sindicato/Categoria",
      "default": "SINDEEPRES"
    },
    "comarca_uf": {
      "type": "string",
      "title": "Comarca/UF"
    },
    "regiao_trt": {
      "type": "string",
      "title": "Região TRT"
    },
    "rito": {
      "type": "string",
      "enum": [
        "ordinario",
        "sumarissimo"
      ],
      "title": "Rito"
    },
    "tipo_dispensa": {
      "type": "string",
      "enum": [
        "sem_justa_causa",
        "rescisao_indireta",
        "nulidade_pedido_demissao",
        "reversao_justa_causa",
        "acordo"
      ],
      "title": "Modalidade de rescisão"
    },
    "tem_tomadora": {
      "type": "boolean",
      "title": "Tem tomadora (responsabilidade subsidiária)",
      "default": false
    },
    "teses": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Teses jurídicas"
    },
    "secoes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Esqueleto de seções"
    },
    "diferencial": {
      "type": "string",
      "title": "Diferencial (o que é particular desta peça — usado pela IA na redação)"
    },
    "resumo": {
      "type": "string",
      "title": "Resumo técnico"
    },
    "conteudo": {
      "type": "string",
      "title": "Conteúdo de referência (anonimizado)"
    },
    "arquivo_nome": {
      "type": "string",
      "title": "Arquivo de origem"
    },
    "arquivo_url": {
      "type": "string",
      "title": "URL do DOCX original (Base44 storage)"
    },
    "prioridade": {
      "type": "number",
      "default": 0,
      "title": "Prioridade no matching",
      "description": "Pontos somados ao matching. Use > 0 nas peças do padrão vigente, para que sirvam de exemplo antes das antigas; as antigas (0) ficam de reserva para as situações que as novas não cobrem."
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "title": "Ativo"
    }
  },
  "required": [
    "titulo"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.acesso_liberado": true
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.acesso_liberado": true
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.acesso_liberado": true
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.acesso_liberado": true
          }
        }
      ]
    }
  }
}