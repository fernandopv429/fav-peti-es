{
  "name": "CCT",
  "type": "object",
  "description": "Convenções Coletivas de Trabalho cadastradas — base para regra de enquadramento sindical, seleção automática de modelo e citação correta de pisos/adicionais/cláusulas nas peças geradas.",
  "properties": {
    "nome": {
      "type": "string",
      "description": "Identificação da CCT (ex: CCT Vigilantes SP 2026/2027 — SESVESP)"
    },
    "categoria": {
      "type": "string",
      "enum": [
        "vigilante",
        "porteiro_sindeepres",
        "porteiro_siemaco",
        "outra"
      ],
      "description": "Categoria profissional / modelo de petição correspondente"
    },
    "sindicato_patronal": {
      "type": "string",
      "description": "Entidade patronal signatária"
    },
    "sindicatos_laborais": {
      "type": "string",
      "description": "Entidade(s) laboral(is) signatária(s) — resumo"
    },
    "registro_mte": {
      "type": "string",
      "description": "Número de registro no MTE (ex: SP000195/2026)"
    },
    "data_registro": {
      "type": "string",
      "format": "date",
      "description": "Data de registro no MTE"
    },
    "vigencia_inicio": {
      "type": "string",
      "format": "date"
    },
    "vigencia_fim_economicas": {
      "type": "string",
      "format": "date",
      "description": "Fim da vigência das cláusulas econômicas"
    },
    "vigencia_fim_sociais": {
      "type": "string",
      "format": "date",
      "description": "Fim da vigência das cláusulas sociais"
    },
    "data_base": {
      "type": "string",
      "description": "Data-base da categoria (ex: 1º de janeiro)"
    },
    "abrangencia_territorial": {
      "type": "string",
      "description": "Base territorial (municípios/UF abrangidos)"
    },
    "abrangencia_categorias": {
      "type": "string",
      "description": "Categorias profissionais abrangidas (texto da cláusula de abrangência)"
    },
    "pisos": {
      "type": "object",
      "description": "Pisos salariais por cargo (chave: cargo, valor: piso em R$ e gratificação se houver)"
    },
    "adicionais": {
      "type": "object",
      "description": "Adicionais e percentuais (HE, noturno, periculosidade, FT, domingos/feriados, etc.)"
    },
    "beneficios": {
      "type": "object",
      "description": "Benefícios e valores (VR, cesta básica, VT, convênio médico, seguro de vida, etc.)"
    },
    "clausulas_chave": {
      "type": "string",
      "description": "Resumo das cláusulas-chave numeradas, para citação literal nas peças"
    },
    "observacoes_estrategicas": {
      "type": "string",
      "description": "Pontos de atenção para teses (limites convencionais, Tema 1046, etc.)"
    },
    "arquivo_url": {
      "type": "string",
      "description": "URL do PDF da CCT registrada"
    },
    "ativo": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "nome",
    "categoria",
    "vigencia_inicio"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.acesso_liberado": true
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.acesso_liberado": true
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.acesso_liberado": true
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.acesso_liberado": true
          }
        }
      ]
    }
  }
}