{
  "name": "EspecialistaConfig",
  "type": "object",
  "properties": {
    "numero": {
      "type": "string",
      "title": "Número"
    },
    "nome": {
      "type": "string",
      "title": "Nome"
    },
    "descricao": {
      "type": "string",
      "title": "Descrição"
    },
    "prompt_sistema": {
      "type": "string",
      "title": "Prompt de Sistema"
    },
    "modelo_ia": {
      "type": "string",
      "enum": [
        "claude_opus_4_6",
        "claude_sonnet_4_6",
        "gemini_3_1_pro",
        "automatic"
      ],
      "default": "claude_sonnet_4_6",
      "title": "Modelo de IA"
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "title": "Ativo"
    }
  },
  "required": [
    "numero",
    "nome",
    "prompt_sistema"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.acesso_liberado": true
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.acesso_liberado": true
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.acesso_liberado": true
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.acesso_liberado": true
          }
        }
      ]
    }
  }
}