{
  "name": "PetitionTemplate",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome do modelo"
    },
    "case_type": {
      "type": "string",
      "enum": [
        "trabalhista",
        "civel",
        "previdenciario",
        "consumidor",
        "outro"
      ],
      "description": "Tipo de ação"
    },
    "description": {
      "type": "string",
      "description": "Descrição do modelo"
    },
    "file_url": {
      "type": "string",
      "description": "URL do arquivo do modelo"
    },
    "file_name": {
      "type": "string",
      "description": "Nome do arquivo"
    },
    "content": {
      "type": "string",
      "description": "Conteúdo extraído do modelo"
    },
    "modelo_docx_url": {
      "type": "string",
      "description": "URL do arquivo .docx oficial tokenizado (para geração determinística)"
    },
    "modelo_docx_name": {
      "type": "string",
      "description": "Nome do arquivo .docx oficial"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Tags para organização e filtragem"
    },
    "use_count": {
      "type": "number",
      "default": 0,
      "description": "Quantidade de vezes utilizado em petições"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Se o modelo está ativo"
    }
  },
  "required": [
    "name",
    "case_type"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.acesso_liberado": true
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.acesso_liberado": true
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.acesso_liberado": true
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.acesso_liberado": true
          }
        }
      ]
    }
  }
}