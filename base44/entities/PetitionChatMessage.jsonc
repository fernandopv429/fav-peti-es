{
  "name": "PetitionChatMessage",
  "type": "object",
  "description": "Histórico de mensagens do chat de correção de petições — preserva a conversa entre sessões e armazena correções aplicadas e regras sugeridas pela IA.",
  "properties": {
    "petition_id": {
      "type": "string",
      "description": "ID da petição vinculada"
    },
    "role": {
      "type": "string",
      "enum": [
        "user",
        "assistant"
      ],
      "description": "Autor da mensagem: usuário (advogado) ou assistente (IA)"
    },
    "text": {
      "type": "string",
      "description": "Conteúdo da mensagem — instrução de correção (user) ou resposta estruturada (assistant)"
    },
    "corrected_fields": {
      "type": "object",
      "description": "Campos da Petition que devem mudar e seus novos valores (apenas mensagens do assistant)"
    },
    "rule_suggestion": {
      "type": "string",
      "description": "Regra curta e genérica sugerida pela IA para evitar o mesmo erro em gerações futuras"
    },
    "rule_saved": {
      "type": "boolean",
      "default": false,
      "description": "Indica se a regra sugerida já foi salva no prompt_sistema do PetitionConfig"
    }
  },
  "required": [
    "petition_id",
    "role",
    "text"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.acesso_liberado": true
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.acesso_liberado": true
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.acesso_liberado": true
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.acesso_liberado": true
          }
        }
      ]
    }
  }
}