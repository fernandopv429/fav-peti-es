{
  "name": "ChatMessage",
  "type": "object",
  "properties": {
    "template_id": {
      "type": "string",
      "title": "Template ID"
    },
    "role": {
      "type": "string",
      "enum": [
        "user",
        "assistant"
      ],
      "title": "Papel"
    },
    "text": {
      "type": "string",
      "title": "Mensagem"
    },
    "corrected_values": {
      "type": "object",
      "title": "Valores Corrigidos"
    },
    "skill_suggestion": {
      "type": "string",
      "title": "Sugestão de Skill"
    }
  },
  "required": [
    "template_id",
    "role",
    "text"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.acesso_liberado": true
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.acesso_liberado": true
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.acesso_liberado": true
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.acesso_liberado": true
          }
        }
      ]
    }
  }
}