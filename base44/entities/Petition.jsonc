{
  "name": "Petition",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Título da petição"
    },
    "status": {
      "type": "string",
      "enum": [
        "rascunho",
        "em_geracao",
        "concluida",
        "revisao_necessaria",
        "pronto_para_protocolo"
      ],
      "default": "rascunho",
      "description": "Status da petição"
    },
    "case_type": {
      "type": "string",
      "enum": [
        "trabalhista",
        "civel",
        "previdenciario",
        "consumidor",
        "outro"
      ],
      "description": "Tipo de ação"
    },
    "rite": {
      "type": "string",
      "enum": [
        "ordinario",
        "sumarissimo",
        "sumario"
      ],
      "description": "Rito processual"
    },
    "claimant_name": {
      "type": "string",
      "description": "Nome completo do reclamante"
    },
    "claimant_cpf": {
      "type": "string",
      "description": "CPF do reclamante (ex: 123.456.789-00)"
    },
    "claimant_rg": {
      "type": "string",
      "description": "RG do reclamante"
    },
    "claimant_birth_date": {
      "type": "string",
      "description": "Data de nascimento"
    },
    "claimant_ctps": {
      "type": "string",
      "description": "Número da CTPS"
    },
    "claimant_pis": {
      "type": "string",
      "description": "PIS/PASEP"
    },
    "claimant_address": {
      "type": "string",
      "description": "Endereço completo do reclamante"
    },
    "claimant_role": {
      "type": "string",
      "description": "Função/cargo do reclamante (ex: Vigilante)"
    },
    "defendant_name": {
      "type": "string",
      "description": "Razão social da reclamada principal (empregadora)"
    },
    "defendant_cnpj": {
      "type": "string",
      "description": "CNPJ da reclamada principal (ex: 12.345.678/0001-90)"
    },
    "defendant_address": {
      "type": "string",
      "description": "Endereço completo da reclamada principal"
    },
    "extra_defendants": {
      "type": "array",
      "description": "Reclamadas adicionais (tomadoras, responsáveis solidárias, etc.)",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "cnpj": {
            "type": "string"
          },
          "address": {
            "type": "string"
          }
        }
      }
    },
    "contract_start": {
      "type": "string",
      "format": "date",
      "description": "Data de admissão"
    },
    "contract_end": {
      "type": "string",
      "format": "date",
      "description": "Data de demissão/rescisão"
    },
    "salary": {
      "type": "number",
      "description": "Salário base mensal em R$ (ex: 2148.22)"
    },
    "work_schedule": {
      "type": "string",
      "description": "Jornada de trabalho alegada (ex: 18:30 às 07:30)"
    },
    "irregularities": {
      "type": "string",
      "description": "Irregularidades alegadas pelo reclamante — texto livre descritivo"
    },
    "additional_facts": {
      "type": "string",
      "description": "Contexto adicional do caso, fatos relevantes ou pendências de validação identificadas pela IA"
    },
    "claims": {
      "type": "array",
      "description": "Lista de pedidos/teses da petição",
      "items": {
        "type": "string"
      }
    },
    "estimated_value": {
      "type": "number",
      "description": "Valor estimado da causa em R$"
    },
    "generated_content": {
      "type": "string",
      "description": "Conteúdo da petição gerado pela IA — texto completo ou URL do arquivo .txt/.docx gerado"
    },
    "template_used": {
      "type": "string",
      "description": "ID ou nome do template utilizado na geração"
    },
    "document_urls": {
      "type": "array",
      "description": "URLs dos documentos anexados à petição (provas, holerites, CTPS, etc.)",
      "items": {
        "type": "string"
      }
    },
    "document_names": {
      "type": "array",
      "description": "Nomes dos arquivos anexados (espelha document_urls)",
      "items": {
        "type": "string"
      }
    },
    "jurisdiction": {
      "type": "string",
      "description": "Comarca/Vara de competência (ex: ARUJÁ/SP — 2ª Região)"
    },
    "free_justice": {
      "type": "boolean",
      "default": true,
      "description": "Beneficiário da justiça gratuita"
    },
    "digital_court": {
      "type": "boolean",
      "default": true,
      "description": "Protocolo em vara digital (PJe)"
    },
    "analise_documentos": {
      "type": "string",
      "description": "Laudo de issue-spotting gerado pela IA a partir dos documentos anexados. Revisão obrigatória pelo advogado antes da geração da inicial."
    },
    "analise_status": {
      "type": "string",
      "enum": [
        "pendente",
        "em_analise",
        "concluida",
        "sem_documentos"
      ],
      "default": "pendente",
      "description": "Status da análise de documentos"
    },
    "grupo_funcao": {
      "type": "string",
      "title": "Grupo de função",
      "description": "Grupo derivado da função registrada (GrupoFuncao); define quem enxerga o registro"
    }
  },
  "required": [
    "title",
    "case_type",
    "claimant_name",
    "defendant_name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "data.acesso_liberado": true
              }
            },
            {
              "$or": [
                {
                  "created_by_id": "{{user.id}}"
                },
                {
                  "data.grupo_funcao": {
                    "$in": "{{user.data.grupos_visiveis}}"
                  }
                },
                {
                  "$and": [
                    {
                      "user_condition": {
                        "data.ve_sem_categoria": true
                      }
                    },
                    {
                      "$or": [
                        {
                          "data.grupo_funcao": {
                            "$exists": false
                          }
                        },
                        {
                          "data.grupo_funcao": "Sem categoria"
                        },
                        {
                          "data.grupo_funcao": ""
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.acesso_liberado": true
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "data.acesso_liberado": true
              }
            },
            {
              "$or": [
                {
                  "created_by_id": "{{user.id}}"
                },
                {
                  "data.grupo_funcao": {
                    "$in": "{{user.data.grupos_visiveis}}"
                  }
                },
                {
                  "$and": [
                    {
                      "user_condition": {
                        "data.ve_sem_categoria": true
                      }
                    },
                    {
                      "data.grupo_funcao": {
                        "$in": [
                          "Sem categoria",
                          ""
                        ]
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "data.acesso_liberado": true
              }
            },
            {
              "created_by_id": "{{user.id}}"
            }
          ]
        }
      ]
    }
  }
}