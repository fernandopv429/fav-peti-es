{
  "name": "Template",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Título"
    },
    "description": {
      "type": "string",
      "title": "Descrição"
    },
    "content": {
      "type": "string",
      "title": "Conteúdo"
    },
    "content_url": {
      "type": "string",
      "title": "URL do Conteúdo"
    },
    "skill": {
      "type": "string",
      "title": "Skill da IA"
    },
    "web_search": {
      "type": "boolean",
      "default": false,
      "title": "Buscar na Internet"
    },
    "search_sites": {
      "type": "string",
      "title": "Sites Prioritários"
    },
    "is_default": {
      "type": "boolean",
      "default": false,
      "title": "Modelo padrão"
    },
    "variables": {
      "type": "array",
      "title": "Variáveis",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "title": "Nome"
          },
          "description": {
            "type": "string",
            "title": "Descrição"
          },
          "example": {
            "type": "string",
            "title": "Exemplo"
          }
        }
      }
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.acesso_liberado": true
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.acesso_liberado": true
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.acesso_liberado": true
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.acesso_liberado": true
          }
        }
      ]
    }
  }
}