{
  "name": "PeticaoReferencia",
  "type": "object",
  "description": "Vínculo entre uma petição e um modelo de referência/precedente da biblioteca, com anotações do advogado.",
  "properties": {
    "petition_id": {
      "type": "string",
      "description": "ID da petição"
    },
    "modelo_id": {
      "type": "string",
      "description": "ID do ModeloReferencia vinculado"
    },
    "titulo": {
      "type": "string",
      "description": "Título do modelo/precedente no momento do vínculo"
    },
    "notas": {
      "type": "string",
      "description": "Anotações do advogado sobre o uso deste precedente na petição"
    }
  },
  "required": [
    "petition_id",
    "modelo_id",
    "titulo"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.acesso_liberado": true
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.acesso_liberado": true
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.acesso_liberado": true
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.acesso_liberado": true
          }
        }
      ]
    }
  }
}