{
  "name": "WebhookEvento",
  "type": "object",
  "properties": {
    "origem": {
      "type": "string",
      "title": "Origem"
    },
    "evento_tipo": {
      "type": "string",
      "title": "Tipo do Evento"
    },
    "evento_id": {
      "type": "string",
      "title": "ID do Evento (idempotência)"
    },
    "payload": {
      "type": "object",
      "title": "Payload recebido"
    },
    "template_id": {
      "type": "string",
      "title": "Modelo indicado no payload (PetitionTemplate)"
    },
    "status": {
      "type": "string",
      "enum": [
        "recebido",
        "processando",
        "processado",
        "erro",
        "aguardando_dados"
      ],
      "default": "recebido",
      "title": "Status"
    },
    "ip_origem": {
      "type": "string",
      "title": "IP de origem"
    },
    "erro_mensagem": {
      "type": "string",
      "title": "Mensagem de erro"
    },
    "processado_em": {
      "type": "string",
      "format": "date-time",
      "title": "Processado em"
    }
  },
  "required": [
    "origem",
    "evento_tipo"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.acesso_liberado": true
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.acesso_liberado": true
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.acesso_liberado": true
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.acesso_liberado": true
          }
        }
      ]
    }
  }
}