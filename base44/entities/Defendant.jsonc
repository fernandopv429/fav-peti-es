{
  "name": "Defendant",
  "type": "object",
  "description": "Cadastro de empresas reclamadas para reutilização em múltiplas petições",
  "properties": {
    "company_name": {
      "type": "string",
      "description": "Razão social"
    },
    "trade_name": {
      "type": "string",
      "description": "Nome fantasia"
    },
    "cnpj": {
      "type": "string",
      "description": "CNPJ"
    },
    "address": {
      "type": "string",
      "description": "Endereço completo"
    },
    "city": {
      "type": "string",
      "description": "Cidade"
    },
    "state": {
      "type": "string",
      "description": "Estado (UF)"
    },
    "economic_activity": {
      "type": "string",
      "description": "Ramo de atividade"
    },
    "employee_count": {
      "type": "string",
      "enum": [
        "microempresa",
        "pequena",
        "media",
        "grande",
        ""
      ],
      "description": "Porte da empresa"
    },
    "notes": {
      "type": "string",
      "description": "Observações relevantes"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Cadastro ativo"
    }
  },
  "required": [
    "company_name",
    "cnpj"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.acesso_liberado": true
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.acesso_liberado": true
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.acesso_liberado": true
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.acesso_liberado": true
          }
        }
      ]
    }
  }
}