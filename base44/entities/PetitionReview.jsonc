{
  "name": "PetitionReview",
  "type": "object",
  "properties": {
    "petition_id": {
      "type": "string",
      "description": "ID da petição"
    },
    "comment": {
      "type": "string",
      "description": "Comentário ou anotação"
    },
    "type": {
      "type": "string",
      "enum": [
        "comentario",
        "edicao",
        "aprovacao",
        "rejeicao"
      ],
      "default": "comentario",
      "description": "Tipo de entrada no histórico"
    }
  },
  "required": [
    "petition_id",
    "comment",
    "type"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.acesso_liberado": true
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.acesso_liberado": true
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.acesso_liberado": true
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.acesso_liberado": true
          }
        }
      ]
    }
  }
}