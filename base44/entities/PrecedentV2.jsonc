{
  "name": "PrecedentV2",
  "type": "object",
  "description": "Banco de jurisprudência definitivo — versão única com link JusBrasil embutido e controle de versão",
  "properties": {
    "title": {
      "type": "string",
      "description": "Título do precedente"
    },
    "source": {
      "type": "string",
      "description": "Tribunal (ex: TST, TRT-2)"
    },
    "reference": {
      "type": "string",
      "description": "Número da súmula ou OJ"
    },
    "category": {
      "type": "string",
      "enum": [
        "horas_extras",
        "verbas_rescisórias",
        "dano_moral",
        "equiparação_salarial",
        "assedio",
        "intervalo",
        "outro"
      ]
    },
    "content": {
      "type": "string",
      "description": "Ementa completa"
    },
    "source_url": {
      "type": "string",
      "description": "Link direto JusBrasil"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "version": {
      "type": "string",
      "description": "Data da última atualização da súmula"
    },
    "last_checked": {
      "type": "string",
      "format": "date-time",
      "description": "Data da última verificação do link"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "title",
    "source",
    "reference",
    "content",
    "category",
    "source_url"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.acesso_liberado": true
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.acesso_liberado": true
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.acesso_liberado": true
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.acesso_liberado": true
          }
        }
      ]
    }
  }
}