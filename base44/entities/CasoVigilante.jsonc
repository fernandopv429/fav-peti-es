{
  "name": "CasoVigilante",
  "type": "object",
  "description": "Dados estruturados de um caso de Reclamação Trabalhista Vigilante 12x36 — espelha os tokens do modelo MODELO_BASE_Vigilante_12x36.docx (campos + valores_pedidos). Usado para preenchimento determinístico e exportação de dados.json compatível com o gerador local preencher_modelo.py.",
  "properties": {
    "titulo": {
      "type": "string",
      "description": "Identificação do caso (ex: Fernando x Belfort)"
    },
    "status": {
      "type": "string",
      "enum": [
        "rascunho",
        "preenchido",
        "gerado",
        "exportado"
      ],
      "default": "rascunho",
      "description": "Status do caso"
    },
    "petition_id": {
      "type": "string",
      "description": "ID da Petition vinculada"
    },
    "tipo_dispensa": {
      "type": "string",
      "enum": [
        "sem_justa_causa",
        "rescisao_indireta",
        "nulidade_pedido_demissao",
        "reversao_justa_causa"
      ],
      "description": "Tipo de dispensa capturado da entrevista (seção 1 — Tipo de Dispensa). Usado para pré-seleção determinística no modal Confirmar Teses."
    },
    "acumulo_funcao": {
      "type": "boolean",
      "default": false,
      "description": "Acúmulo/desvio de função detectado na entrevista (seção 8)"
    },
    "DANO_SUPERVISOR": {
      "type": "string",
      "description": "Nome do superior hierárquico informado na entrevista (para pedido de dano moral)"
    },
    "DANO_FATOS": {
      "type": "string",
      "description": "Resumo dos fatos de dano moral/assédio relatados pela reclamante (texto livre da entrevista)"
    },
    "dano_sem_estrutura": {
      "type": "boolean",
      "default": false,
      "description": "Posto não tinha banheiro/bebedouro — fundamenta dano moral"
    },
    "tem_insalubridade": {
      "type": "boolean",
      "default": false,
      "description": "Insalubridade detectada na entrevista (seção 13)"
    },
    "tem_periculosidade": {
      "type": "boolean",
      "default": false,
      "description": "Periculosidade detectada na entrevista (seção 13)"
    },
    "tem_adic_noturno": {
      "type": "boolean",
      "default": false,
      "description": "Adicional noturno: jornada com horas entre 22h e 05h"
    },
    "COMARCA_UF": {
      "type": "string",
      "description": "Comarca/UF da Vara (ex: ARUJÁ/SP)"
    },
    "REGIAO_TRT": {
      "type": "string",
      "description": "Região do TRT (ex: SEGUNDA REGIÃO)"
    },
    "RECL_NOME": {
      "type": "string",
      "description": "Nome do reclamante"
    },
    "RECL_NACIONALIDADE": {
      "type": "string",
      "default": "brasileiro",
      "description": "Nacionalidade do reclamante (ex: brasileiro)"
    },
    "RECL_ESTADOCIVIL": {
      "type": "string",
      "description": "Estado civil do reclamante (ex: solteiro, casado, divorciado)"
    },
    "RECL_RG": {
      "type": "string",
      "description": "RG do reclamante (ex: 12.345.678-9)"
    },
    "RECL_PIS": {
      "type": "string",
      "description": "PIS/PASEP do reclamante (ex: 123.45678.91-0)"
    },
    "RECL_SERIE": {
      "type": "string",
      "description": "Série da CTPS"
    },
    "RECL_CTPS": {
      "type": "string",
      "description": "Número da CTPS do reclamante (ex: 12345)"
    },
    "RECL_CPF": {
      "type": "string",
      "description": "CPF do reclamante (ex: 123.456.789-00)"
    },
    "RECL_NASC": {
      "type": "string",
      "description": "Data de nascimento (ex: 29/03/1988)"
    },
    "RECL_FILIACAO": {
      "type": "string",
      "description": "Filiação do reclamante — nome do pai e/ou mãe"
    },
    "RECL_ENDERECO": {
      "type": "string",
      "description": "Endereço completo do reclamante"
    },
    "RECL_CEP": {
      "type": "string",
      "description": "CEP do reclamante (ex: 12345-678)"
    },
    "RECL1_NOME": {
      "type": "string",
      "description": "1ª Reclamada (empregadora) - razão social"
    },
    "RECL1_CNPJ": {
      "type": "string",
      "description": "CNPJ da 1ª Reclamada (ex: 12.345.678/0001-90)"
    },
    "RECL1_LOGRADOURO": {
      "type": "string",
      "description": "Logradouro da 1ª Reclamada (rua, número, bairro)"
    },
    "RECL1_ENDCOMPL": {
      "type": "string",
      "description": "Complemento de endereço da 1ª Reclamada (cidade, UF, CEP)"
    },
    "RECL2_NOME": {
      "type": "string",
      "description": "2ª Reclamada (tomadora) - razão social"
    },
    "RECL2_CNPJ": {
      "type": "string",
      "description": "CNPJ da 2ª Reclamada (ex: 12.345.678/0001-90)"
    },
    "RECL2_LOGRADOURO": {
      "type": "string",
      "description": "Logradouro da 2ª Reclamada (rua, número, bairro)"
    },
    "RECL2_ENDCOMPL": {
      "type": "string",
      "description": "Complemento de endereço da 2ª Reclamada (cidade, UF, CEP)"
    },
    "RECL3_NOME": {
      "type": "string",
      "description": "3ª Reclamada (tomadora) - razão social"
    },
    "RECL3_CNPJ": {
      "type": "string",
      "description": "CNPJ da 3ª Reclamada (ex: 12.345.678/0001-90)"
    },
    "RECL3_LOGRADOURO": {
      "type": "string",
      "description": "Logradouro da 3ª Reclamada (rua, número, bairro)"
    },
    "RECL3_ENDCOMPL": {
      "type": "string",
      "description": "Complemento de endereço da 3ª Reclamada (cidade, UF, CEP)"
    },
    "FORO_COMPETENCIA": {
      "type": "string",
      "description": "Foro de competência (ex: ARUJÁ/SP)"
    },
    "LOCAL_PRESTACAO": {
      "type": "string",
      "description": "Local de prestação de serviços (nome do posto/cliente)"
    },
    "LOCAL_PRESTACAO_COMPL": {
      "type": "string",
      "description": "Complemento do local de prestação (endereço completo do posto)"
    },
    "DATA_ADMISSAO": {
      "type": "string",
      "description": "Ex: 04 de junho de 2012"
    },
    "FUNCAO": {
      "type": "string",
      "default": "Vigilante",
      "description": "Função do reclamante (ex: Vigilante)"
    },
    "DATA_RESCISAO": {
      "type": "string",
      "description": "Ex: 15 de julho de 2025"
    },
    "SALARIO": {
      "type": "string",
      "description": "Ex: R$ 2.148,22"
    },
    "JORNADA_HORARIO": {
      "type": "string",
      "description": "Ex: 18:30 às 07:30"
    },
    "JORNADA_EXTRAPOLA": {
      "type": "string",
      "description": "Ex: 09:00"
    },
    "JORNADA_FREQ_EXTRA": {
      "type": "string",
      "description": "Ex: 4 a 6 vezes por mês"
    },
    "INTERVALO_GOZADO": {
      "type": "string",
      "description": "Ex: 10 (dez) a 15 (quinze) minutos"
    },
    "LOCAL_DATA_ASSINATURA": {
      "type": "string",
      "description": "Ex: São Paulo, 11 de agosto de 2025"
    },
    "CCT_VIGENCIA": {
      "type": "string",
      "default": "2024/2025",
      "description": "Vigência da CCT (ex: 2024/2025)"
    },
    "ADIC_CONV": {
      "type": "string",
      "default": "60%",
      "description": "Adicional convencional de horas extras (ex: 60%)"
    },
    "VAL_FT": {
      "type": "string",
      "description": "Valor da FT/folga trabalhada em R$ (ex: R$ 180,00). NUNCA 'Sim'/'Não'."
    },
    "FT_QTD_MEDIA": {
      "type": "string",
      "description": "Quantidade média de folgas trabalhadas (FTs) por mês (ex: '07 a 09 por mês'). Capturado da entrevista como número/descrição, nunca como Sim/Não."
    },
    "VAL_CONDUCAO": {
      "type": "string",
      "description": "Ex: R$ 10,00"
    },
    "VAL_ALIMENTACAO": {
      "type": "string",
      "description": "Ex: R$ 39,00"
    },
    "VALOR_CAUSA": {
      "type": "string",
      "description": "Valor da causa (ex: R$ 399.391,86)"
    },
    "valores_pedidos": {
      "type": "object",
      "description": "Valores do rol de pedidos P01 a P87 (chave: valor em texto, ex: P01: 'R$ 21.482,20')"
    }
  },
  "required": [
    "titulo"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.acesso_liberado": true
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.acesso_liberado": true
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.acesso_liberado": true
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.acesso_liberado": true
          }
        }
      ]
    }
  }
}