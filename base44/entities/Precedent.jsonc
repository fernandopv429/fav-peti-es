{
  "name": "Precedent",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Título do precedente/jurisprudência"
    },
    "source": {
      "type": "string",
      "description": "Tribunal/Órgão (ex: TST, TRT-2)"
    },
    "reference": {
      "type": "string",
      "description": "Número do acórdão ou súmula"
    },
    "category": {
      "type": "string",
      "enum": [
        "horas_extras",
        "verbas_rescisórias",
        "dano_moral",
        "equiparação_salarial",
        "assedio",
        "intervalo",
        "outro"
      ],
      "description": "Categoria temática"
    },
    "content": {
      "type": "string",
      "description": "Ementa ou texto do precedente"
    },
    "source_url": {
      "type": "string",
      "description": "Link oficial para consulta (JusBrasil, TST, etc.)"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Tags para busca"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "title",
    "source",
    "content",
    "category"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.acesso_liberado": true
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.acesso_liberado": true
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.acesso_liberado": true
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.acesso_liberado": true
          }
        }
      ]
    }
  }
}