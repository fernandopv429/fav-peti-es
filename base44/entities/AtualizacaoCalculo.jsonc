{
  "name": "AtualizacaoCalculo",
  "type": "object",
  "description": "Cálculos de atualização monetária e juros",
  "properties": {
    "title": {
      "type": "string",
      "description": "Identificação do cálculo"
    },
    "origem_debito": {
      "type": "string",
      "enum": [
        "trabalhista",
        "dano_material",
        "dano_moral",
        "tributario",
        "alimentos",
        "contratual"
      ],
      "description": "Origem do débito"
    },
    "valor_original": {
      "type": "number",
      "description": "Valor original"
    },
    "data_inicial": {
      "type": "string",
      "format": "date",
      "description": "Data inicial"
    },
    "data_final": {
      "type": "string",
      "format": "date",
      "description": "Data final"
    },
    "indice_correcao": {
      "type": "string",
      "enum": [
        "selic",
        "ipca_e",
        "inpc",
        "igpm",
        "tr"
      ],
      "description": "Índice de correção"
    },
    "indice_acumulado": {
      "type": "number",
      "description": "Índice acumulado do período (%)"
    },
    "juros_percent_mes": {
      "type": "number",
      "default": 1,
      "description": "Juros ao mês (%)"
    },
    "selic_embutida": {
      "type": "boolean",
      "default": false,
      "description": "Selic já engloba juros (Tema 99 STJ)"
    },
    "honorarios_percent": {
      "type": "number",
      "description": "Honorários (%)"
    },
    "multa_10_percent": {
      "type": "boolean",
      "default": false,
      "description": "Multa art. 475-J/523 CPC (10%)"
    },
    "valor_correcao": {
      "type": "number"
    },
    "valor_juros": {
      "type": "number"
    },
    "valor_honorarios": {
      "type": "number"
    },
    "valor_multa": {
      "type": "number"
    },
    "valor_atualizado": {
      "type": "number"
    },
    "memoria_calculo": {
      "type": "string"
    },
    "fundamento_indice": {
      "type": "string",
      "description": "Fundamento legal do índice utilizado"
    }
  },
  "required": [
    "title",
    "valor_original",
    "data_inicial",
    "data_final"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.acesso_liberado": true
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.acesso_liberado": true
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.acesso_liberado": true
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.acesso_liberado": true
          }
        }
      ]
    }
  }
}