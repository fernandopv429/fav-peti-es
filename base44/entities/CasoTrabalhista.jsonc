{
  "name": "CasoTrabalhista",
  "type": "object",
  "properties": {
    "titulo": {
      "type": "string",
      "title": "Título"
    },
    "status": {
      "type": "string",
      "enum": [
        "rascunho",
        "em_analise",
        "auditado",
        "gerado",
        "revisao",
        "pronto",
        "aguardando_dados"
      ],
      "default": "rascunho",
      "title": "Status"
    },
    "origem_evento_id": {
      "type": "string",
      "title": "ID do evento de origem (webhook)",
      "description": "ID estável do lead/entrevista de origem (payload.id), igual em reenvios — usado para atualizar em vez de duplicar a peça ao reprocessar o mesmo evento."
    },
    "entrevista_texto": {
      "type": "string",
      "title": "Texto da Entrevista"
    },
    "recl_nome": {
      "type": "string",
      "title": "Nome do Reclamante"
    },
    "recl_cpf": {
      "type": "string",
      "title": "CPF"
    },
    "recl_rg": {
      "type": "string",
      "title": "RG"
    },
    "recl_pis": {
      "type": "string",
      "title": "PIS"
    },
    "recl_ctps": {
      "type": "string",
      "title": "CTPS"
    },
    "recl_endereco": {
      "type": "string",
      "title": "Endereço do Reclamante"
    },
    "recl1_nome": {
      "type": "string",
      "title": "1ª Reclamada - Nome"
    },
    "recl1_cnpj": {
      "type": "string",
      "title": "1ª Reclamada - CNPJ"
    },
    "recl1_logradouro": {
      "type": "string",
      "title": "1ª Reclamada - Logradouro"
    },
    "recl1_complemento": {
      "type": "string",
      "title": "1ª Reclamada - Complemento"
    },
    "recl2_nome": {
      "type": "string",
      "title": "2ª Reclamada - Nome"
    },
    "recl2_cnpj": {
      "type": "string",
      "title": "2ª Reclamada - CNPJ"
    },
    "recl3_nome": {
      "type": "string",
      "title": "3ª Reclamada - Nome"
    },
    "recl3_cnpj": {
      "type": "string",
      "title": "3ª Reclamada - CNPJ"
    },
    "data_admissao": {
      "type": "string",
      "format": "date",
      "title": "Data de Admissão"
    },
    "data_rescisao": {
      "type": "string",
      "format": "date",
      "title": "Data de Rescisão"
    },
    "funcao": {
      "type": "string",
      "title": "Função"
    },
    "salario": {
      "type": "number",
      "title": "Salário"
    },
    "jornada_horario": {
      "type": "string",
      "title": "Jornada/Horário"
    },
    "jornada_extrapola": {
      "type": "boolean",
      "title": "Jornada Extrapola"
    },
    "jornada_freq_extra": {
      "type": "string",
      "title": "Frequência de Extras"
    },
    "intervalo_gozado": {
      "type": "boolean",
      "title": "Intervalo Gozado"
    },
    "tipo_dispensa": {
      "type": "string",
      "enum": [
        "sem_justa_causa",
        "rescisao_indireta",
        "nulidade_pedido_demissao",
        "reversao_justa_causa",
        "acordo"
      ],
      "title": "Modalidade de Rescisão"
    },
    "val_ft": {
      "type": "number",
      "title": "Valor Folgas Trabalhadas"
    },
    "ft_qtd_media": {
      "type": "number",
      "title": "Qtd Média FT"
    },
    "val_conducao": {
      "type": "number",
      "title": "Valor Condução"
    },
    "val_alimentacao": {
      "type": "number",
      "title": "Valor Alimentação"
    },
    "comarca_uf": {
      "type": "string",
      "title": "Comarca/UF"
    },
    "regiao_trt": {
      "type": "string",
      "title": "Região TRT"
    },
    "dano_supervisor": {
      "type": "string",
      "title": "Dano - Supervisor"
    },
    "dano_fatos": {
      "type": "string",
      "title": "Dano - Fatos"
    },
    "dano_sem_estrutura": {
      "type": "boolean",
      "title": "Dano - Sem Estrutura"
    },
    "tem_ft": {
      "type": "boolean",
      "title": "Tem FT"
    },
    "tem_dano_moral": {
      "type": "boolean",
      "title": "Tem Dano Moral"
    },
    "tem_desvio": {
      "type": "boolean",
      "title": "Tem Desvio de Função"
    },
    "tem_acumulo": {
      "type": "boolean",
      "title": "Tem Acúmulo de Função"
    },
    "acumulo_funcao": {
      "type": "string",
      "title": "Descrição Acúmulo"
    },
    "tem_insalubridade": {
      "type": "boolean",
      "title": "Tem Insalubridade"
    },
    "tem_periculosidade": {
      "type": "boolean",
      "title": "Tem Periculosidade"
    },
    "tem_adic_noturno": {
      "type": "boolean",
      "title": "Tem Adicional Noturno"
    },
    "document_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "URLs dos Documentos"
    },
    "document_names": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Nomes dos Documentos"
    },
    "analise_status": {
      "type": "string",
      "enum": [
        "pendente",
        "em_andamento",
        "concluida",
        "erro"
      ],
      "default": "pendente",
      "title": "Status da Análise"
    },
    "analise_laudo": {
      "type": "string",
      "title": "Laudo da Análise"
    },
    "analise_json": {
      "type": "object",
      "title": "Resultado da Auditoria"
    },
    "template_id": {
      "type": "string",
      "title": "Template Utilizado"
    },
    "auditado_em": {
      "type": "string",
      "format": "date-time",
      "title": "Auditado em"
    },
    "status_final_auditoria": {
      "type": "string",
      "enum": [
        "bloqueado",
        "revisar",
        "aprovado"
      ],
      "title": "Status Final da Auditoria"
    },
    "grupo_funcao": {
      "type": "string",
      "title": "Grupo de função",
      "description": "Grupo derivado da função registrada (GrupoFuncao); define quem enxerga o registro"
    },
    "revisado_por": {
      "type": [
        "string",
        "null"
      ],
      "title": "Revisado por (e-mail)"
    },
    "revisado_por_nome": {
      "type": [
        "string",
        "null"
      ],
      "title": "Revisado por (nome)"
    },
    "revisado_em": {
      "type": [
        "string",
        "null"
      ],
      "title": "Revisado em"
    }
  },
  "required": [
    "titulo"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "data.acesso_liberado": true
              }
            },
            {
              "$or": [
                {
                  "created_by_id": "{{user.id}}"
                },
                {
                  "data.grupo_funcao": {
                    "$in": "{{user.data.grupos_visiveis}}"
                  }
                },
                {
                  "$and": [
                    {
                      "user_condition": {
                        "data.ve_sem_categoria": true
                      }
                    },
                    {
                      "$or": [
                        {
                          "data.grupo_funcao": {
                            "$exists": false
                          }
                        },
                        {
                          "data.grupo_funcao": "Sem categoria"
                        },
                        {
                          "data.grupo_funcao": ""
                        }
                      ]
                    }
                  ]
                },
                {
                  "user_condition": {
                    "data.ve_todas": true
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.acesso_liberado": true
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "data.acesso_liberado": true
              }
            },
            {
              "$or": [
                {
                  "created_by_id": "{{user.id}}"
                },
                {
                  "data.grupo_funcao": {
                    "$in": "{{user.data.grupos_visiveis}}"
                  }
                },
                {
                  "$and": [
                    {
                      "user_condition": {
                        "data.ve_sem_categoria": true
                      }
                    },
                    {
                      "data.grupo_funcao": {
                        "$in": [
                          "Sem categoria",
                          ""
                        ]
                      }
                    }
                  ]
                },
                {
                  "user_condition": {
                    "data.ve_todas": true
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "data.acesso_liberado": true
              }
            },
            {
              "created_by_id": "{{user.id}}"
            }
          ]
        }
      ]
    }
  }
}
