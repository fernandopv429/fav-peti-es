{
  "name": "VerbaRescisoriaCalculo",
  "type": "object",
  "description": "Cálculo de verbas rescisórias (TRCT) gerado pela Calculadora de Verbas — espelha o agente calculo-verbas-rescisorias",
  "properties": {
    "title": {
      "type": "string",
      "description": "Identificação do cálculo"
    },
    "claimant_name": {
      "type": "string",
      "description": "Nome do empregado"
    },
    "claimant_cpf": {
      "type": "string",
      "description": "CPF"
    },
    "admission_date": {
      "type": "string",
      "format": "date",
      "description": "Data de admissão"
    },
    "termination_date": {
      "type": "string",
      "format": "date",
      "description": "Data de demissão"
    },
    "termination_reason": {
      "type": "string",
      "enum": [
        "sem_justa_causa",
        "justa_causa",
        "pedido_demissao",
        "acordo_484a",
        "prazo_determinado",
        "aposentadoria",
        "falecimento",
        "rescisao_indireta"
      ],
      "description": "Motivo do desligamento — define quais verbas são devidas"
    },
    "aviso_tipo": {
      "type": "string",
      "enum": [
        "trabalhado",
        "indenizado",
        "dispensado"
      ],
      "description": "Tipo de aviso prévio"
    },
    "salary_base": {
      "type": "number",
      "description": "Salário base mensal"
    },
    "media_variavel": {
      "type": "number",
      "default": 0,
      "description": "Média de parcelas variáveis dos últimos 12 meses (HE, comissões)"
    },
    "saldo_fgts": {
      "type": "number",
      "default": 0,
      "description": "Saldo do FGTS na conta vinculada"
    },
    "anos_completos": {
      "type": "number",
      "description": "Anos completos de contrato (para aviso Lei 12.506)"
    },
    "aviso_dias": {
      "type": "number",
      "description": "Dias de aviso prévio calculados"
    },
    "saldo_salario": {
      "type": "number",
      "description": "Saldo de salário"
    },
    "aviso_valor": {
      "type": "number",
      "description": "Aviso prévio indenizado"
    },
    "ferias_vencidas": {
      "type": "number",
      "description": "Férias vencidas + 1/3"
    },
    "ferias_proporcionais": {
      "type": "number",
      "description": "Férias proporcionais + 1/3 (com aviso projetado)"
    },
    "decimo_terceiro": {
      "type": "number",
      "description": "13º proporcional (com aviso projetado)"
    },
    "fgts_deposito_rescisorio": {
      "type": "number",
      "description": "Depósitos de FGTS rescisórios (8% sobre aviso e 13º)"
    },
    "multa_fgts": {
      "type": "number",
      "description": "Multa do FGTS (40%, 20% ou 0 conforme motivo)"
    },
    "multa_477": {
      "type": "number",
      "description": "Multa do art. 477 §8º, se pagamento fora do prazo"
    },
    "total_bruto": {
      "type": "number",
      "description": "Total bruto das verbas"
    },
    "total_liquido": {
      "type": "number",
      "description": "Total líquido (após INSS e IRRF, respeitando não-incidências)"
    },
    "memoria_calculo": {
      "type": "string",
      "description": "Memória de cálculo detalhada (TRCT em texto)"
    },
    "petition_id": {
      "type": "string",
      "description": "ID da petição vinculada, quando gerado a partir de um caso"
    },
    "notes": {
      "type": "string",
      "description": "Observações e alertas (não-incidências, pendências)"
    }
  },
  "required": [
    "title",
    "termination_reason",
    "salary_base"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.acesso_liberado": true
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.acesso_liberado": true
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.acesso_liberado": true
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.acesso_liberado": true
          }
        }
      ]
    }
  }
}