{
  "name": "GenerationLog",
  "type": "object",
  "description": "Log de todas as gerações de petições pela IA — rastreabilidade e auditoria",
  "properties": {
    "petition_id": {
      "type": "string",
      "description": "ID da petição"
    },
    "petition_title": {
      "type": "string",
      "description": "Título da petição"
    },
    "status": {
      "type": "string",
      "enum": [
        "iniciado",
        "concluido",
        "erro"
      ],
      "description": "Status da geração"
    },
    "model_used": {
      "type": "string",
      "description": "Modelo de IA utilizado"
    },
    "template_id": {
      "type": "string",
      "description": "ID do template utilizado"
    },
    "precedents_count": {
      "type": "number",
      "description": "Quantidade de precedentes usados"
    },
    "tokens_used": {
      "type": "number",
      "description": "Tokens consumidos"
    },
    "duration_seconds": {
      "type": "number",
      "description": "Tempo de geração em segundos"
    },
    "error_message": {
      "type": "string",
      "description": "Mensagem de erro se houver"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data e hora da geração"
    },
    "generated_by": {
      "type": "string",
      "description": "Usuário que gerou"
    }
  },
  "required": [
    "petition_id",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.acesso_liberado": true
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.acesso_liberado": true
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.acesso_liberado": true
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.acesso_liberado": true
          }
        }
      ]
    }
  }
}