{
  "name": "Defesa",
  "type": "object",
  "description": "Contestações trabalhistas geradas pelo sistema",
  "properties": {
    "title": {
      "type": "string",
      "description": "Título da defesa"
    },
    "process_number": {
      "type": "string",
      "description": "Número do processo"
    },
    "reclamante_name": {
      "type": "string",
      "description": "Nome do reclamante"
    },
    "reclamada_name": {
      "type": "string",
      "description": "Nome da reclamada"
    },
    "reclamada_cnpj": {
      "type": "string",
      "description": "CNPJ da reclamada"
    },
    "contract_start": {
      "type": "string",
      "format": "date",
      "description": "Data de admissão"
    },
    "contract_end": {
      "type": "string",
      "format": "date",
      "description": "Data de demissão"
    },
    "funcao": {
      "type": "string",
      "description": "Função do reclamante"
    },
    "salario": {
      "type": "number",
      "description": "Salário do reclamante"
    },
    "inicial_texto": {
      "type": "string",
      "description": "Texto da reclamação inicial"
    },
    "generated_content": {
      "type": "string",
      "description": "Contestação gerada pela IA"
    },
    "status": {
      "type": "string",
      "enum": [
        "rascunho",
        "em_geracao",
        "concluida"
      ],
      "default": "rascunho"
    }
  },
  "required": [
    "title",
    "reclamante_name",
    "reclamada_name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.acesso_liberado": true
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.acesso_liberado": true
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.acesso_liberado": true
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.acesso_liberado": true
          }
        }
      ]
    }
  }
}