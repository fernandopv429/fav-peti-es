{
  "name": "Client",
  "type": "object",
  "description": "Cadastro de clientes/reclamantes para reutilização em múltiplas petições",
  "properties": {
    "full_name": {
      "type": "string",
      "description": "Nome completo"
    },
    "cpf": {
      "type": "string",
      "description": "CPF"
    },
    "rg": {
      "type": "string",
      "description": "RG"
    },
    "birth_date": {
      "type": "string",
      "format": "date",
      "description": "Data de nascimento"
    },
    "address": {
      "type": "string",
      "description": "Endereço completo"
    },
    "city": {
      "type": "string",
      "description": "Cidade"
    },
    "state": {
      "type": "string",
      "description": "Estado (UF)"
    },
    "phone": {
      "type": "string",
      "description": "Telefone"
    },
    "email": {
      "type": "string",
      "description": "E-mail"
    },
    "ctps": {
      "type": "string",
      "description": "Número da CTPS"
    },
    "pis": {
      "type": "string",
      "description": "PIS/PASEP"
    },
    "bank": {
      "type": "string",
      "description": "Banco para pagamento"
    },
    "bank_agency": {
      "type": "string",
      "description": "Agência"
    },
    "bank_account": {
      "type": "string",
      "description": "Conta"
    },
    "free_justice": {
      "type": "boolean",
      "default": true,
      "description": "Beneficiário de justiça gratuita"
    },
    "notes": {
      "type": "string",
      "description": "Observações"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Cadastro ativo"
    }
  },
  "required": [
    "full_name",
    "cpf"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.acesso_liberado": true
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.acesso_liberado": true
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.acesso_liberado": true
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.acesso_liberado": true
          }
        }
      ]
    }
  }
}