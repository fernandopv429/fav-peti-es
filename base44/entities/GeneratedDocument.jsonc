{
  "name": "GeneratedDocument",
  "type": "object",
  "properties": {
    "template_id": {
      "type": "string",
      "title": "Template ID"
    },
    "template_title": {
      "type": "string",
      "title": "Título do Template"
    },
    "variable_values": {
      "type": "object",
      "title": "Valores das Variáveis"
    },
    "source_files": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Arquivos de Origem"
    },
    "status": {
      "type": "string",
      "enum": [
        "processing",
        "completed",
        "failed"
      ],
      "default": "completed",
      "title": "Status"
    }
  },
  "required": [
    "template_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.acesso_liberado": true
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.acesso_liberado": true
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.acesso_liberado": true
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.acesso_liberado": true
          }
        }
      ]
    }
  }
}