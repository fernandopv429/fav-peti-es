{
  "name": "DefesaConfig",
  "type": "object",
  "description": "Configurações do gerador de defesas/contestações",
  "properties": {
    "escritorio": {
      "type": "string",
      "description": "Nome do escritório"
    },
    "prompt_sistema": {
      "type": "string",
      "description": "Prompt de sistema para geração das defesas"
    },
    "modelo_ia": {
      "type": "string",
      "description": "Modelo de IA",
      "default": "claude_sonnet_4_6"
    },
    "max_tokens": {
      "type": "number",
      "default": 4000
    },
    "ativo": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "escritorio"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.acesso_liberado": true
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.acesso_liberado": true
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.acesso_liberado": true
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.acesso_liberado": true
          }
        }
      ]
    }
  }
}